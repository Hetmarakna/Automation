# SmartApply Local Environment Configuration
# Copy this file to .env and configure your credentials.
# Note: Never commit your real .env file with secrets into version control.

# Flask secret key for session management
SECRET_KEY=change-this-to-a-random-secure-string-for-local-session

# Outgoing SMTP Configuration (Gmail default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_SENDER_EMAIL=your.email@gmail.com
SMTP_SENDER_NAME=Your Name

# Gmail 16-character App Password (requires 2-Step Verification enabled)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
